{
  "$schema": "http://json.schemastore.org/template",
  "author": "VolocyNazad",
  "classifications": [ "Revit", "Library", "NuGet" ],
  "identity": "VolocyNazad.Revit.Templates.Lib",
  "name": "Revit library project (nupkg)",
  "description": "A library project at the toolkit.revit.* level (src/ + tests/, MinVer, packaged into NuGet) without a repository skeleton - for adding into an already existing repository. Use a name of the form Revit.<Feature>, e.g. Revit.Foo.",
  "shortName": "revit-lib",
  "sourceName": "Revit.Sample",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "nameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      }
    },
    "repoSlug": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "separator": "",
        "symbols": [
          { "type": "const", "value": "toolkit." },
          { "type": "ref", "value": "nameLower" }
        ]
      },
      "replaces": "toolkit.revit.sample"
    }
  },
  "primaryOutputs": [
    { "path": "src/Revit.Sample/Revit.Sample.csproj" }
  ]
}
